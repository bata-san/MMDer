{
  "name": "mmd-lab-viewer",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:background": "python scripts/build-background.py",
    "dev:background": "npm run prepare:background && vite",
    "build:client": "vite build",
    "build:background": "npm run prepare:background && npm run build:client",
    "build": "npm run build:client",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:worker",
    "verify": "node scripts/verify.mjs",
    "check": "npm run typecheck && npm run build && npm run verify",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "cf:types": "wrangler types",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "three": "0.166.1",
    "tw-animate-css": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
