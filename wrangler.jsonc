{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mmd-lab-viewer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
